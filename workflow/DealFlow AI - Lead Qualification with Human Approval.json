    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst src = $('Code - Validate & Sanitize').first().json;\nlet raw = null;\nlet parseOk = true;\ntry {\n  raw = item.output || (item.candidates && item.candidates[0] && item.candidates[0].content && item.candidates[0].content.parts ? item.candidates[0].content.parts.map(function (x) { return x.text || ''; }).join('') : null);\n  if (typeof raw === 'string') {\n    raw = JSON.parse(raw.replace(/^```(?:json)?/i, '').replace(/```$/, '').trim());\n  }\n  if (!raw || typeof raw !== 'object') throw new Error('Respuesta no es un objeto');\n} catch (e) {\n  parseOk = false;\n  raw = {};\n}\n\nfunction toInt(v, fallback) {\n  const n = parseInt(String(v).replace(/[^0-9-]/g, ''), 10);\n  return isNaN(n) ? fallback : n;\n}\n\nlet score = toInt(raw.lead_score, 0) - src.score_penalty;\nscore = Math.max(0, Math.min(100, score));\nlet prioridad = ['Alta', 'Media', 'Baja'].indexOf(raw.prioridad) > -1 ? raw.prioridad : (score >= 75 ? 'Alta' : score >= 45 ? 'Media' : 'Baja');\n\nconst usage = item.usageMetadata || {};\nconst tokensIn = toInt(usage.promptTokenCount, 0);\nconst tokensOut = toInt(usage.candidatesTokenCount, 0);\n\nreturn [{\n  json: {\n    parse_ok: parseOk,\n    lead_score: score,\n    prioridad: prioridad,\n    resumen_dolor: String(raw.resumen_dolor || 'No disponible'),\n    propuesta_tecnica: String(raw.propuesta_tecnica || 'No disponible'),\n    monto_estimado: Math.max(0, parseFloat(String(raw.monto_estimado).replace(/[^0-9.]/g, '')) || 0),\n    justificacion_comercial: String(raw.justificacion_comercial || 'No disponible'),\n    tokens_entrada: tokensIn,\n    tokens_salida: tokensOut,\n    tokens_total: toInt(usage.totalTokenCount, tokensIn + tokensOut),\n  },\n}];"
      },
