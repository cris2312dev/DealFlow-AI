      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst GENERIC = ['gmail.com', 'hotmail.com', 'outlook.com', 'yahoo.com', 'live.com', 'icloud.com', 'proton.me', 'protonmail.com'];\nconst EMAIL_RE = /^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$/;\n\nfunction sanitize(value, maxLen) {\n  return String(value === undefined || value === null ? '' : value)\n    .replace(/<[^>]*>/g, '')\n    .replace(/[<>`$\\\\{}]/g, '')\n    .replace(/[\\u0000-\\u001F\\u007F]/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .slice(0, maxLen);\n}\n\nconst hasGt = String(body.presupuesto === undefined || body.presupuesto === null ? '' : body.presupuesto).indexOf('>') > -1;\nconst nombre = sanitize(body.nombre, 120);\nconst email = sanitize(body.email, 200).toLowerCase();\nconst empresa = sanitize(body.empresa, 160);\nconst mensaje = sanitize(body.mensaje, 2000);\nconst presupuesto = sanitize(body.presupuesto, 60);\nconst nums = presupuesto.match(/[0-9][0-9.,]*/g) || [];\nconst vals = nums.map(function (n) { return parseInt(n.replace(/[.,]/g, ''), 10); }).filter(function (n) { return !isNaN(n); });\nconst maxVal = vals.length ? Math.max.apply(null, vals) : null;\nlet presupuestoOpcion = '';\nif (maxVal !== null) {\n  if (hasGt || maxVal > 5000) presupuestoOpcion = '> $5.000';\n  else if (maxVal >= 1000) presupuestoOpcion = '$1.000 - $5.000';\n  else presupuestoOpcion = '< $1.000';\n}\n\nconst errors = [];\nif (!nombre) errors.push('nombre requerido');\nif (!EMAIL_RE.test(email)) errors.push('formato de email invalido');\nif (mensaje.length < 15) errors.push('mensaje demasiado corto');\n\nconst domain = email.indexOf('@') > -1 ? email.split('@')[1] : '';\nconst isCorporate = domain !== '' && GENERIC.indexOf(domain) === -1;\nconst scorePenalty = isCorporate ? 0 : 20;\n\nreturn [{\n  json: {\n    is_valid: errors.length === 0,\n    errors: errors,\n    error_text: errors.join('; '),\n    nombre: nombre,\n    email: email,\n    empresa: empresa,\n    mensaje: mensaje,\n    presupuesto: presupuesto,\n    presupuesto_opcion: presupuestoOpcion,\n    dominio: domain,\n    es_corporativo: isCorporate,\n    score_penalty: scorePenalty,\n    raw_payload: JSON.stringify(body).slice(0, 4000),\n  },\n}];"
      },
